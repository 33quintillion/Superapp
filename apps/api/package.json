{
  "name": "@nexa/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "dev": "tsc -p tsconfig.build.json && node dist/src/main.js",
    "migrate": "tsc -p tsconfig.build.json && node dist/src/database/migrate.cli.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "vapid-keys": "tsc -p tsconfig.build.json && node dist/src/push/vapid-keys.cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1140.0",
    "@aws-sdk/s3-request-presigner": "3.1140.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-fastify": "11.2.8",
    "argon2": "^0.45.1",
    "fastify": "5.11.3",
    "ioredis": "^6.0.0",
    "jose": "^5.10.0",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "8.21.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "8.18.1",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "5.9.3"
  }
}
