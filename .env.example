# Copy to apps/api/.env (or export) for local development. No real secrets here.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Only true when the API sits behind a proxy/load balancer you control.
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3001

DATABASE_URL=postgres://superapp:superapp_dev@localhost:5432/superapp_dev
REDIS_URL=redis://localhost:6379/0

# Generate your own: openssl rand -hex 32
JWT_ACCESS_SECRET=
# Generate your own: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Nexa <no-reply@localhost>"
PUBLIC_WEB_URL=http://localhost:3001

# Object storage for chat media (SeaweedFS from infra/docker-compose.yml locally).
S3_ENDPOINT=http://localhost:9000
# Only if clients reach storage on a different host than the API does.
# S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=nexa-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Local development only; refused in staging and production.
S3_AUTO_CREATE_BUCKET=true

# Web app (apps/web): server-side only, never exposed to the browser.
API_INTERNAL_URL=http://localhost:3000
# Where browsers open the chat WebSocket (they only ever get a one-time ticket).
API_PUBLIC_WS_URL=ws://localhost:3000
