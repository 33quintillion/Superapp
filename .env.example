# Copy to apps/api/.env (or export) for local development. No real secrets here.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Only true when the API sits behind a proxy/load balancer you control.
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3001

DATABASE_URL=postgres://superapp:superapp_dev@localhost:5432/superapp_dev
REDIS_URL=redis://localhost:6379/0

# Generate your own: openssl rand -hex 32
JWT_ACCESS_SECRET=
# Generate your own: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Nexa <no-reply@localhost>"
PUBLIC_WEB_URL=http://localhost:3001

# Web app (apps/web): server-side only, never exposed to the browser.
API_INTERNAL_URL=http://localhost:3000
