# Copy to apps/api/.env (or export) for local development. No real secrets here.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# The load balancers and the web server that may set X-Forwarded-For: IPs or CIDRs, comma-separated.
# true (trust anyone) is for local use only and refused in staging and production.
TRUST_PROXY=false
CORS_ORIGINS=http://localhost:3001

# New passwords are checked against Have I Been Pwned's Pwned Passwords (free, no key; only the
# first 5 characters of the password's SHA-1 are sent). off skips it; a short common list still applies.
PASSWORD_BREACH_CHECK=hibp

DATABASE_URL=postgres://superapp:superapp_dev@localhost:5432/superapp_dev
REDIS_URL=redis://localhost:6379/0

# People sign up with their phone number (Firebase codes). Email sign-up is off unless set here;
# local development keeps it on so you can sign up without a Firebase project.
EMAIL_SIGNUP=true
# Phone sign-in: the Firebase project ID (Project settings → General). Unset turns it off.
# FIREBASE_PROJECT_ID=
# Country codes phone sign-in accepts, comma-separated.
# PHONE_COUNTRY_CODES=+91

# Generate your own: openssl rand -hex 32
JWT_ACCESS_SECRET=
# Generate your own: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# smtp, or brevo (Brevo's HTTPS API, for hosts that block outbound SMTP; needs BREVO_API_KEY).
MAIL_TRANSPORT=smtp
# BREVO_API_KEY=
SMTP_URL=smtp://localhost:1025
# Optional sign-in for SMTP_URL, pasted as is (no URL encoding needed).
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM="Nexa <no-reply@localhost>"
PUBLIC_WEB_URL=http://localhost:3001

# Object storage for chat media (SeaweedFS from infra/docker-compose.yml locally).
S3_ENDPOINT=http://localhost:9000
# Only if clients reach storage on a different host than the API does.
# S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=nexa-media
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
# Local development only; refused in staging and production.
S3_AUTO_CREATE_BUCKET=true
# For a bucket provisioned elsewhere (staging, production): set the CORS rule to CORS_ORIGINS at startup.
# S3_MANAGE_CORS=true

# Web app (apps/web): server-side only, never exposed to the browser.
API_INTERNAL_URL=http://localhost:3000
# Where browsers open the chat WebSocket (they only ever get a one-time ticket).
API_PUBLIC_WS_URL=ws://localhost:3000
# How many proxies sit in front of the web server; its client address is that many entries from the end of X-Forwarded-For.
WEB_PROXY_HOPS=0
# Where browsers upload and download media (the S3 public endpoint), for the Content Security Policy.
# Defaults to localhost:9000 in development; required in production or photos won't load.
# CSP_MEDIA_ORIGINS=https://media.example.com

# Push notifications (docs/push.md). Each provider is optional and independent.
# Web Push for browsers: generate with `pnpm --filter @nexa/api vapid-keys`.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
# APNs (iPhone): from an Apple Developer account, Keys → APNs.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=
# APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# FCM (Android): Firebase service account JSON, raw or base64.
# FCM_SERVICE_ACCOUNT_JSON=

# Calls (docs/calls.md). STUN works without an account; TURN needs a provider for real networks.
STUN_URLS=stun:stun.cloudflare.com:3478
# none | coturn | twilio | cloudflare
TURN_PROVIDER=none
# all, or relay to send every call through TURN (hides IP addresses; needs a TURN provider).
ICE_TRANSPORT_POLICY=all
# coturn with use-auth-secret:
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
# TURN_SHARED_SECRET=
# Twilio Network Traversal Service (API key, not the auth token):
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# Cloudflare Realtime TURN:
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=

# Payments (docs/payments.md). none | stripe
PAYMENTS_PROVIDER=none
# STRIPE_SECRET_KEY=sk_test_...
# Comma-separated while rotating.
# STRIPE_WEBHOOK_SECRET=whsec_...
# Only for the local stand-in (pnpm --filter @nexa/api stripe-sandbox); refused in staging and production.
# STRIPE_API_BASE=http://127.0.0.1:12111
# STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
# Nexa's fee on orders, in basis points (100 = 1%).
# PAYMENTS_PLATFORM_FEE_BPS=0
# PAYMENTS_CHECKOUT_MINUTES=30
# PAYMENTS_SWEEP_INTERVAL_SECONDS=60

# Admin dashboard: how long a two-step sign-in stays valid for admin work, in hours.
# ADMIN_SESSION_MAX_HOURS=12
